#!/usr/bin/env python3
"""Read-only verification that Claude and Codex use the same project-memory launcher."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib


def main() -> int:
    parser = argparse.ArgumentParser(description='Verify shared per-project TinyContext memory')
    parser.add_argument('--profile', choices=('private', 'working'), default=os.getenv('MM_AGENT_PROFILE', 'private'))
    parser.add_argument('--project', default=os.getenv('MM_TINYCONTEXT_PROJECT_ROOT', os.getcwd()))
    args = parser.parse_args()
    home = Path.home()
    launcher = (home / '.local/bin/mm-tinycontext-mcp').resolve()
    resolver = (home / '.local/bin/mm-tinycontext-path').resolve()
    env = dict(os.environ, MM_AGENT_PROFILE=args.profile)
    if not resolver.is_file():
        print('FAIL  Shared path resolver not installed')
        return 1
    try:
        result = subprocess.run([str(resolver), 'info', '--project', args.project, '--profile', args.profile],
                                env=env, text=True, capture_output=True, check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f'FAIL  Project resolution: {exc}')
        return 1
    print('TinyContext shared project memory')
    for line in result.stdout.strip().splitlines():
        print('INFO  ' + line)
    print(f'INFO  Expected MCP executable: {launcher}')
    nodes: dict[str, object] = {}
    try:
        cfg = json.loads((home / '.claude.json').read_text())
        nodes['Claude Code'] = cfg.get('mcpServers', {}).get('mm-tinycontext')
    except (OSError, ValueError, AttributeError):
        nodes['Claude Code'] = None
    try:
        cfg = tomllib.loads((home / '.codex/config.toml').read_text())
        nodes['Codex CLI'] = cfg.get('mcp_servers', {}).get('mm-tinycontext')
    except (OSError, ValueError, AttributeError):
        nodes['Codex CLI'] = None
    success = True
    for name, node in nodes.items():
        if isinstance(node, dict) and node.get('command') == str(launcher) and node.get('args', []) == [] and not node.get('env'):
            print(f'PASS  {name} points to shared mm-tinycontext-mcp')
        else:
            print(f'FAIL  {name} does not use the expected shared MCP launcher')
            success = False
    if success:
        print('PASS  Both agents select the same SQLite file for this project/profile')
    else:
        print('TIP   Run ./setup-global-mcps.sh and check for conflicting MCP entries')
    print('INFO  Stored project decisions are shared; full chat transcripts are not automatically synchronized.')
    return 0 if success else 1


if __name__ == '__main__':
    sys.exit(main())
