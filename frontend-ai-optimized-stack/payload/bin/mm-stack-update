#!/usr/bin/env bash
set -euo pipefail
# Independent lanes keep skill refreshes separate from memory/plugin updates.
if [[ $# -eq 0 ]]; then set -- --skills; fi
for lane in "$@"; do
  case "$lane" in
    --skills) mm-refresh-skills --only vercel ;;
    --memory) tinycontext-doctor --update ;;
    --plugins)
      if command -v claude >/dev/null 2>&1 && claude plugin list 2>/dev/null | grep -qi skill-creator; then
        claude plugin marketplace update claude-plugins-official
        claude plugin update skill-creator@claude-plugins-official --scope user
      fi
      ;;
    --help|-h) echo 'Usage: mm-stack-update [--skills] [--memory] [--plugins]'; exit 0 ;;
    *) echo "Unknown lane: $lane" >&2; exit 2 ;;
  esac
 done
 echo 'PASS  Requested update lanes completed. Run mm-skill-audit --strict.'
