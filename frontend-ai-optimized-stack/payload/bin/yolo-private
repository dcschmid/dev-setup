#!/usr/bin/env bash
set -euo pipefail
command -v omp >/dev/null || { echo 'ERROR: omp missing. Install from https://omp.sh/install.' >&2; exit 127; }
export MM_AGENT_PROFILE=private
export OMP_PROFILE=private
export MM_TINYCONTEXT_PROJECT_ROOT="${MM_TINYCONTEXT_PROJECT_ROOT:-$PWD}"
exec omp --profile private "$@"
