# Kitty Workspace Pack - shared shell secrets
#
# Copy/edit this file ONLY after rotating any previously exposed credentials.
# The installed real file is:
#   ~/.config/kitty-workspace/secrets.zsh
#
# It is created with mode 0600 and is sourced by Zsh.
# setup-shell-secrets.sh can also make Bash source the same file.
#
# Example:
# export LEMONADE_API_KEY='replace-with-rotated-key'
# export YOLO_AUTO_API_KEY='replace-with-rotated-key'
