#!/usr/bin/env bash
set -euo pipefail

if command -v kitten >/dev/null 2>&1; then
  exec kitten quick-access-terminal "$@"
fi

if [[ -x "$HOME/.local/kitty.app/bin/kitten" ]]; then
  exec "$HOME/.local/kitty.app/bin/kitten" quick-access-terminal "$@"
fi

echo "kitten command not found. Is Kitty installed?" >&2
exit 1
